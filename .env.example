DATABASE_URL=postgresql+psycopg://nodema:local_dev_only@127.0.0.1:55432/nodema
# Optional direct PostgreSQL URL for migrations; never put real credentials in this template.
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=postgresql+psycopg://nodema:local_dev_only@127.0.0.1:55432/nodema_test

# Optional: required only for legacy ciphertext migration, encrypted backups, or MMDB bundles.
ENCRYPTION_KEY_ID=local-v1
ENCRYPTION_KEY_B64=
FINGERPRINT_KEY_B64=
SOURCE_MAX_BYTES=10485760
SOURCE_MAX_ITEMS=10000
SOURCE_TOTAL_TIMEOUT_SECONDS=30
SOURCE_MAX_REDIRECTS=3
SOURCE_SYNC_INTERVAL_SECONDS=86400
SOURCE_SUBSTORE_MAX_FETCHES=256
SOURCE_SUBSTORE_MAX_ITEMS=50000
SOURCE_SUBSTORE_MAX_DEPTH=3
SOURCE_SUBSTORE_TIMEOUT_SECONDS=120
ADMIN_PASSWORD=
MIHOMO_BINARY=private/bin/mihomo
MIHOMO_REUSE=true
MIHOMO_MAX_NODES_PER_PROCESS=250
CHECK_CONCURRENCY=4
CHECK_BATCH_SIZE=16
# auto includes Runner country/ASN, IP family, Echo target and measurement profile.
RUNNER_PROBE_ID=auto
DNS_CACHE_MAX_TTL_SECONDS=300
DNS_NEGATIVE_TTL_SECONDS=15
TCP_CACHE_TTL_SECONDS=60
TCP_FAILURE_TTL_SECONDS=15
PRECHECK_GATE_ENABLED=true
PRECHECK_SAMPLE_RATE=0.1
# Affects pending work only; completed daily snapshots are immutable.
CHECK_FORCE_FULL=false
FAILURE_COOLDOWN_ENABLED=true
FAILURE_COOLDOWN_THRESHOLD=3
FAILURE_COOLDOWN_BASE_HOURS=6
FAILURE_COOLDOWN_MAX_HOURS=72
ECHO_URL=
ECHO_TOKEN=
DNS_TIMEOUT_SECONDS=3
TCP_TIMEOUT_SECONDS=5
HTTP_TIMEOUT_SECONDS=10
RETRY_DELAY_SECONDS=10
DEGRADED_HTTP_MS=8000
FRESHNESS_HOURS=36
SHARD_SIZE=250
SHARD_LEASE_SECONDS=300
GEOIP_CITY_PATH=
GEOIP_ASN_PATH=
DETAIL_RETENTION_DAYS=60
STATS_RETENTION_DAYS=365
# New subscriptions stay valid until revoked by default; set expiry per profile in Dashboard.
# EXPORT_TTL_HOURS is accepted only for older env compatibility; it no longer sets link expiry.
GITHUB_REPOSITORY=
GITHUB_DISPATCH_TOKEN=
GITHUB_WORKFLOW_REF=main
SCAN_TIMEZONE=Asia/Shanghai
MAXMIND_ACCOUNT_ID=
# Optional locally; Actions downloads and installs both MMDBs when both Secrets are set.
MAXMIND_LICENSE_KEY=
