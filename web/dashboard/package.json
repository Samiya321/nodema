{
  "name": "nodema-dashboard",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 8788",
    "dev:pages": "npm run build && wrangler pages dev dist --port 8788 --inspector-port 9231 --log-level error",
    "build": "vite build",
    "preview": "vite preview --port 8788",
    "types": "wrangler types",
    "check": "tsc --noEmit -p tsconfig.functions.json && tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "lucide-react": "^1.82.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^5",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wrangler": "^4"
  },
  "engines": {
    "node": ">=22"
  }
}
